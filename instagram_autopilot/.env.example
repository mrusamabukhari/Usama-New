# Instagram Graph API credentials
# Get these from https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# Anthropic API key for Claude
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Brand info (used by Claude for on-brand captions)
BRAND_NAME=Your Brand Name
BRAND_NICHE=e.g. fitness, fashion, food, tech
BRAND_TONE=e.g. professional, playful, inspirational

# Posting schedule (24h format, comma-separated)
POST_TIMES=09:00,17:00,21:00
